rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tutors directory: public read, write for tutor management and admin reset
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings: read and write for scheduling sessions
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews: public read, creation for student feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Accounts: user accounts and credentials
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if true;
    }

    // Applications: tutor applications for peer tutor certification
    match /applications/{applicationId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications: real-time updates for sessions and reviews
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // System connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
